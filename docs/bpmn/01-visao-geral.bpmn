<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_overview" targetNamespace="https://github.com/halyfsoares/market-dashboard/bpmn" exporter="market-dashboard/generate_bpmn.py" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_overview">
    <bpmn:participant id="Ext_yahoo" name="Yahoo Finance (EUA + B3)" />
    <bpmn:participant id="Ext_coingecko" name="CoinGecko (cripto)" />
    <bpmn:participant id="Ext_fxmacro" name="FXMacroData (calendário EUA)" />
    <bpmn:participant id="Ext_biquote" name="Biquote.io (calendário BR)" />
    <bpmn:participant id="Supabase" name="Supabase Cloud" processRef="Process_Supabase" />
    <bpmn:participant id="Dashboard" name="Usuário · Dashboard" processRef="Process_Dashboard" />
    <bpmn:messageFlow id="Msg_21" name="Fetch (JSON)" sourceRef="sp_market" targetRef="Ext_yahoo" />
    <bpmn:messageFlow id="Msg_22" name="Fetch (JSON)" sourceRef="sp_market" targetRef="Ext_coingecko" />
    <bpmn:messageFlow id="Msg_23" name="Fetch (JSON)" sourceRef="sp_econ" targetRef="Ext_fxmacro" />
    <bpmn:messageFlow id="Msg_24" name="Fetch (JSON)" sourceRef="sp_br" targetRef="Ext_biquote" />
    <bpmn:messageFlow id="Msg_25" name="GET REST" sourceRef="t_req" targetRef="s_rest" />
    <bpmn:messageFlow id="Msg_26" name="JSON" sourceRef="e_rest" targetRef="c_data" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Supabase" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Supabase">
      <bpmn:lane id="Lane_orq" name="Orquestração">
        <bpmn:flowNodeRef>s_hora</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_disp1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_6h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_disp2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_6h15</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_disp3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_diario</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_edge" name="Edge Functions">
        <bpmn:flowNodeRef>sp_market</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_econ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sp_br</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_db" name="PostgreSQL">
        <bpmn:flowNodeRef>ds_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_assets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ds_events</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>s_rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_rest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_vac</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="s_hora" name="A cada hora"><bpmn:outgoing>Flow_1</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:startEvent>
    <bpmn:serviceTask id="t_disp1" name="Disparar função (pg_net · POST)"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:startEvent id="s_6h" name="A cada 6 h"><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:startEvent>
    <bpmn:serviceTask id="t_disp2" name="Disparar função (pg_net · POST)"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:startEvent id="s_6h15" name="A cada 6 h (+15 min)"><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:startEvent>
    <bpmn:serviceTask id="t_disp3" name="Disparar função (pg_net · POST)"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:startEvent id="s_diario" name="Diário 03:00"><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:timerEventDefinition /></bpmn:startEvent>
    <bpmn:subProcess id="sp_market" name="fetch-market-data (Edge Function)"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing><bpmn:dataInputAssociation id="DIn_28"><bpmn:sourceRef>ds_assets</bpmn:sourceRef></bpmn:dataInputAssociation><bpmn:dataOutputAssociation id="DOut_27"><bpmn:targetRef>ds_price</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:subProcess>
    <bpmn:subProcess id="sp_econ" name="fetch-economic-events (Edge Function)"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:dataOutputAssociation id="DOut_29"><bpmn:targetRef>ds_events</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:subProcess>
    <bpmn:subProcess id="sp_br" name="fetch-br-events (Edge Function)"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing><bpmn:dataOutputAssociation id="DOut_30"><bpmn:targetRef>ds_events</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:subProcess>
    <bpmn:endEvent id="e_1" name="Concluído"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="e_2" name="Concluído"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="e_3" name="Concluído"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataStoreReference id="ds_price" name="price_history" dataStoreRef="DataStore_price_history" />
    <bpmn:dataStoreReference id="ds_assets" name="assets" dataStoreRef="DataStore_assets" />
    <bpmn:dataStoreReference id="ds_events" name="economic_events" dataStoreRef="DataStore_economic_events" />
    <bpmn:startEvent id="s_rest"><bpmn:outgoing>Flow_13</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:startEvent>
    <bpmn:serviceTask id="t_rest" name="API REST (RLS · só SELECT)"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e_rest"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:messageEventDefinition /></bpmn:endEvent>
    <bpmn:serviceTask id="t_del" name="DELETE preços &gt; 90 dias"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="t_vac" name="VACUUM price_history"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="e_4" name="Retenção concluída"><bpmn:incoming>Flow_12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="s_hora" targetRef="t_disp1" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="s_6h" targetRef="t_disp2" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="s_6h15" targetRef="t_disp3" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="t_disp1" targetRef="sp_market" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="t_disp2" targetRef="sp_econ" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="t_disp3" targetRef="sp_br" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="sp_market" targetRef="e_1" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="sp_econ" targetRef="e_2" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="sp_br" targetRef="e_3" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="s_diario" targetRef="t_del" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="t_del" targetRef="t_vac" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="t_vac" targetRef="e_4" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="s_rest" targetRef="t_rest" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="t_rest" targetRef="e_rest" />
  </bpmn:process>
  <bpmn:process id="Process_Dashboard" isExecutable="false">
    <bpmn:startEvent id="s_user" name="Usuário acessa"><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="t_load" name="Carregar HTML/JS (GitHub Pages)"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:task>
    <bpmn:sendTask id="t_req" name="Solicitar dados (anon key)"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="c_data" name="Dados recebidos"><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing><bpmn:messageEventDefinition /></bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="t_calc" name="Calcular indicadores e termômetro"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="t_render" name="Renderizar gauge, cards e calendário"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="e_dash" name="Dashboard atualizado"><bpmn:incoming>Flow_19</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="s_user" targetRef="t_load" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="t_load" targetRef="t_req" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="c_data" targetRef="t_calc" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="t_calc" targetRef="t_render" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="t_render" targetRef="e_dash" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="t_req" targetRef="c_data" />
  </bpmn:process>
  <bpmn:dataStore id="DataStore_assets" name="assets" />
  <bpmn:dataStore id="DataStore_economic_events" name="economic_events" />
  <bpmn:dataStore id="DataStore_price_history" name="price_history" />
  <bpmndi:BPMNDiagram id="Diagram_overview">
    <bpmndi:BPMNPlane id="Plane_overview" bpmnElement="Collab_overview">
      <bpmndi:BPMNShape id="Shape_Ext_yahoo" bpmnElement="Ext_yahoo" isHorizontal="true"><dc:Bounds x="200" y="20" width="140" height="50" /></bpmndi:BPMNShape>
